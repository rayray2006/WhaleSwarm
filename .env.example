# === LLM (Primary — bulk tasks: NER, profile gen) ===
LLM_PROVIDER=openai
LLM_API_KEY=AIza...
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL_NAME=gemini-3.1-flash-lite-preview

# === LLM (Smart — intelligence-sensitive: ontology, reports) ===
SMART_PROVIDER=openai
SMART_API_KEY=AIza-...
SMART_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SMART_MODEL_NAME=gemini-3.0-flash-preview

# === Embeddings ===
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_API_KEY=AIza...
EMBEDDING_DIMENSIONS=768

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=WhaleSwarm

# === Simulation Defaults ===
DEFAULT_MAX_ROUNDS=10

# === Web Enrichment ===
WEB_ENRICHMENT_ENABLED=true
WEB_SEARCH_MODEL=

# === Polymarket Real-Price Anchoring ===
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_ANCHORING_ENABLED=true

# === Server ===
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false

# === Extension A: Bet Calibration ===
BET_CALIBRATION_ENABLED=false
BET_CALIBRATION_CDF_PATH=backend/data/polymarket_cdfs/cdfs.json
BET_CALIBRATION_FALLBACK=heuristic

# === Extension B: Agent Persistence ===
AGENT_PERSISTENCE_ENABLED=false
MODEL_TIER_BASE=gemini-3.1-flash-lite-preview
MODEL_TIER_MID=gemini-3.0-flash-preview
MODEL_TIER_TOP=gemini-3.1-pro-preview
KILL_THRESHOLD=0.0
WHALE_PERCENTILE=0.01
ELITE_PERCENTILE=0.001
